# Copy to .env and fill in. Never commit .env.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
APP_URL=https://your-app-host.example.com
SHOPIFY_API_VERSION=2026-10
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CODGUARD_TOKEN_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
CODGUARD_PHONE_PEPPER=
# 1 = Shopify test charges (no money moves). Set 0 only for the live listing.
CODGUARD_BILLING_TEST=1
CODGUARD_DB=codguard.sqlite3
HOST=127.0.0.1
PORT=8000
# Optional: WhatsApp Cloud API. Leave blank to disable sending.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
