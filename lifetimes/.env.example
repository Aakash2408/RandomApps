# Copy to .env and fill in. Never commit .env.
# Lemon Squeezy -> Settings -> Stores: numeric store ID
LEMONSQUEEZY_STORE_ID=
# variant_id:pack for each one-time product (packs: plus, editor, rewind, careers, drama)
LEMONSQUEEZY_PACK_VARIANTS=111111:plus,222222:editor,333333:rewind,444444:careers,555555:drama
# Hosted checkout links. Set each product's "Button link" after purchase to
#   https://your-domain/?key=[license_key]
# so buyers are unlocked automatically when they return.
CHECKOUT_URL_PLUS=
CHECKOUT_URL_EDITOR=
CHECKOUT_URL_REWIND=
CHECKOUT_URL_CAREERS=
CHECKOUT_URL_DRAMA=
PRICE_PLUS=$2.99
PRICE_EDITOR=$1.99
PRICE_REWIND=$1.99
PRICE_CAREERS=$1.99
PRICE_DRAMA=$1.99
# Header your proxy appends the real client IP to (last entry used). Confirm for your host.
# Chat and unlock rate limits are per IP, so behind a proxy this MUST be set or every
# player shares one limit.
CLIENT_IP_HEADER=
HOST=127.0.0.1
PORT=8000
