# Copy to .env and fill in. Never commit .env.
#
# --- Website (what the Docker image runs) --------------------------------------
SITE_URL=https://your-domain.example
# Lemon Squeezy -> Settings -> Stores: the numeric store ID.
LEMONSQUEEZY_STORE_ID=
# variant_id:plan for each monthly variant (Products -> your product -> variants).
LEMONSQUEEZY_PLAN_VARIANTS=111111:starter,222222:growth,333333:pro
# Hosted checkout link for each plan (Products -> Share).
CHECKOUT_URL_STARTER=
CHECKOUT_URL_GROWTH=
CHECKOUT_URL_PRO=
CONTACT_EMAIL=
FREE_CHECKS_PER_DAY=20
FREE_CHECKS_GLOBAL_PER_DAY=5000
# Header your hosting proxy APPENDS the real client IP to (last entry is used).
# Likely x-forwarded-for on Railway; confirm in Railway's docs before setting.
CLIENT_IP_HEADER=
HOST=127.0.0.1
PORT=8000

# --- Shopify app (not run by the image; kept for later) ------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
APP_URL=https://your-app-host.example
CODGUARD_TOKEN_KEY=
CODGUARD_PHONE_PEPPER=
CODGUARD_BILLING_TEST=1
